<?xml version="1.0" encoding="utf-8"?>
<!-- 108dp の枠のうち、中央 72dp に収まるように描く (適応アイコンの安全域)
     端末の背面と、叩いたところから広がる波。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 端末の輪郭 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF35D48A"
        android:strokeWidth="4"
        android:pathData="M38,18 h32 a8,8 0 0 1 8,8 v56 a8,8 0 0 1 -8,8
                          h-32 a8,8 0 0 1 -8,-8 v-56 a8,8 0 0 1 8,-8 z" />

    <!-- 叩いたところ -->
    <path
        android:fillColor="#FF35D48A"
        android:pathData="M54,49.5 a4.5,4.5 0 1 1 -0.01,0 z" />

    <!-- 広がる波 (外側ほど薄く) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF35D48A"
        android:strokeWidth="3.5"
        android:pathData="M54,43 a11,11 0 1 1 -0.01,0 z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#8035D48A"
        android:strokeWidth="3"
        android:pathData="M54,36 a18,18 0 1 1 -0.01,0 z" />
</vector>
